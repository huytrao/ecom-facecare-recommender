# Environment configuration for the E-commerce Facecare Recommender
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Data paths (relative to project root)
DATABASE__POPULAR_PRODUCTS_PATH=./data/top_brand_products.csv
DATABASE__COMBINED_PRODUCTS_PATH=./data/data_product_combine.csv
DATABASE__PURCHASE_DATA_PATH=./data/data_purchase.csv
DATABASE__VIETNAMESE_EMBEDDING_PATH=./embeddings/vietnamese_embedding.npy

# API configuration
API__TITLE="E-commerce Facecare Recommender"
API__DESCRIPTION="AI-powered product recommendation system for skincare products"
API__VERSION="1.0.0"
API__DEBUG=false

# Recommendation settings
RECOMMENDATION__DEFAULT_NUM_RECOMMENDATIONS=15
RECOMMENDATION__MAX_RECOMMENDATIONS=50
RECOMMENDATION__SIMILARITY_WEIGHT=0.7
RECOMMENDATION__POPULARITY_WEIGHT=0.3
RECOMMENDATION__TOP_SIMILAR_PRODUCTS=100

# Static files
STATIC__STATIC_DIR=static
STATIC__TEMPLATES_DIR=templates
STATIC__IMAGE_DIR=static/image